{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyPilotPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::REPLACE_WITH_EXACT_BUCKET_NAME",
      "Condition": {
        "StringLike": {"s3:prefix": ["sessions/", "sessions/*", "healthchecks/", "healthchecks/*"]}
      }
    },
    {
      "Sid": "ReadWriteOnlyPilotFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_EXACT_BUCKET_NAME/sessions/*",
        "arn:aws:s3:::REPLACE_WITH_EXACT_BUCKET_NAME/healthchecks/*"
      ]
    }
  ]
}
